---
const links = [
	{ href: '/#research', label: 'Research' },
	{ href: '/#projects', label: 'Projects' },
	{ href: '/#journey', label: 'Journey' },
	{ href: '/#personal', label: 'Personal' },
];
---

<header>
	<nav aria-label="Primary navigation">
		<a class="wordmark" href="/#top" aria-label="Manish, home">M.</a>
		<div class="nav-links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
		<a class="connect-link" href="/#connect">Connect <span aria-hidden="true">↗</span></a>
	</nav>
</header>

<style>
	header {
		position: fixed;
		z-index: 100;
		top: 0;
		left: 0;
		width: 100%;
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(8, 8, 10, 0.68);
		backdrop-filter: saturate(180%) blur(20px);
	}

	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: min(1240px, calc(100% - 3rem));
		height: 3.75rem;
		margin: 0 auto;
	}

	nav a {
		color: rgba(255, 255, 255, 0.88);
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 160ms ease;
	}

	nav a:hover {
		color: white;
	}

	.wordmark {
		width: fit-content;
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.06em;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
	}

	.connect-link {
		justify-self: end;
	}

	.connect-link span {
		margin-left: 0.25rem;
	}

	@media (max-width: 700px) {
		nav {
			grid-template-columns: 1fr 1fr;
			width: calc(100% - 2rem);
		}

		.nav-links {
			display: none;
		}
	}
</style>
