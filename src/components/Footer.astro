---
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<p>Manish</p>
		<p>Computer Science · UC Santa Cruz</p>
		<p>© {year}</p>
	</div>
</footer>

<style>
	footer {
		padding: 2rem 0;
		border-top: 1px solid #262629;
		background: #070709;
		color: #6e6e73;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		width: min(1240px, calc(100% - 3rem));
		margin: 0 auto;
		font-size: 0.75rem;
	}

	p {
		margin: 0;
	}

	p:last-child {
		justify-self: end;
	}

	@media (max-width: 640px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 0.5rem;
			width: calc(100% - 2rem);
		}

		p:last-child {
			justify-self: start;
		}
	}
</style>
