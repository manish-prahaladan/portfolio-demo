		margin-bottom: 1.25rem;
		color: #72ddce;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.rag-source-one {
		left: 0;
	}

	.rag-source-two {
		left: 35%;
	}

	.rag-source-three {
		right: 0;
	}

