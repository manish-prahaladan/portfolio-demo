	.timeline {
		position: relative;
		height: 106rem;
		margin-top: 6rem;
	}

	.timeline-rail {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 2px;
		background: linear-gradient(180deg, #8b83ff, #4f7fa7 68%, #f5f5f7);
		box-shadow: 0 0 1.5rem rgba(94, 92, 230, 0.34);
		transform: translateX(-50%);
	}

	.timeline-item {
		--timeline-accent: #8b83ff;
		--timeline-tint: rgba(94, 92, 230, 0.13);

		position: absolute;
		top: var(--timeline-start);
		width: calc(50% - 3.5rem);
		height: var(--timeline-length);
	}

	.timeline-left {
		right: calc(50% + 3.5rem);
	}

	.timeline-right {
		left: calc(50% + 3.5rem);
	}

	.timeline-amber {
		--timeline-accent: #ffb45d;
		--timeline-tint: rgba(255, 180, 93, 0.12);
	}

	.timeline-blue {
		--timeline-accent: #69b9ff;
		--timeline-tint: rgba(105, 185, 255, 0.12);
	}

	.timeline-amber .timeline-card {
		padding: 1.5rem;
	}

	.timeline-card {
		position: relative;
		display: flex;
		height: 100%;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--timeline-accent) 45%, transparent);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: linear-gradient(145deg, var(--timeline-tint), rgba(255, 255, 255, 0.025));
		box-shadow: inset 0 1px rgba(255, 255, 255, 0.05), 0 1.5rem 4rem rgba(0, 0, 0, 0.16);
		backdrop-filter: blur(16px);
	}

	.timeline-period,
	.timeline-details {
		position: relative;
		z-index: 1;
	}

	.timeline-amazon-mark {
		position: absolute;
		right: -1.5rem;
		bottom: 0.4rem;
		width: 92%;
		fill: none;
		stroke: var(--timeline-accent);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 11;
		opacity: 0.12;
	}

	.timeline-item::before,
	.timeline-item::after {
		position: absolute;
		width: 3.5rem;
		height: 1px;
		background: color-mix(in srgb, var(--timeline-accent) 68%, transparent);
		content: '';
	}

	.timeline-item::before {
		top: 0.55rem;
	}

	.timeline-item::after {
		bottom: 0.55rem;
	}

	.timeline-left::before,
	.timeline-left::after {
		right: -3.5rem;
	}

	.timeline-right::before,
	.timeline-right::after {
		left: -3.5rem;
	}

	.timeline-node {
		position: absolute;
		width: 1.15rem;
		height: 1.15rem;
		border: 2px solid var(--timeline-accent);
		border-radius: 50%;
		background: #070709;
		box-shadow: 0 0 1.1rem color-mix(in srgb, var(--timeline-accent) 55%, transparent);
	}

	.timeline-left .timeline-node {
		right: -4.075rem;
	}

	.timeline-right .timeline-node {
		left: -4.075rem;
	}

	.timeline-node-start {
		top: 0;
	}

	.timeline-node-end {
		bottom: 0;
	}

	.timeline-period {
		margin: 0;
		color: var(--timeline-accent);
