---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const projects = [
	{
		index: '01',
		status: 'Completed',
		title: 'Computational Neuroscience RAG',
		description:
			'A citation-grounded Q&A system for computational neuroscience literature, with validated PMID citations and multi-agent cross-source synthesis.',
		metric: '4-stage',
		metricLabel: 'agentic research pipeline',
		tone: 'dark',
		visual: 'lit-rag',
		url: 'https://github.com/manish-prahaladan/lit_rag',
		appUrl: '/projects/lit-rag',
	},
	{
		index: '02',
		status: 'Completed',
		title: 'Content moderation on Reddit',
		description:
			'Analyzed moderation behavior across 409 Reddit communities using a scalable pipeline covering 200,000+ posts and millions of comments, with survival and causal methods used to study post-removal patterns and engagement outcomes.',
		metric: '409',
		metricLabel: 'communities analyzed',
		tone: 'light',
		visual: 'reddit',
		url: 'https://github.com/amokkapati/ContentModeration/tree/main/reddit',
	},
	{
		index: '03',
		status: 'Completed',
		title: 'BrainoCare',
		description:
			'Developed a Flask-based brain tumor detection system using a custom convolutional neural network trained on 3,064 MRI scans. The model classified scans into three tumor categories and achieved approximately 97.5% test accuracy, with the web application providing an accessible interface for uploading images and viewing predictions.',
		metric: '97.5%',
		metricLabel: 'test accuracy',
		tone: 'light',
		visual: 'brainocare',
		url: 'https://github.com/manish-prahaladan/BrainoCare',
	},
];

const journeyMilestones = [
	{
		period: 'Aug 2019 — Apr 2023',
		type: 'Education',
		title: 'Sri Krishna College of Engineering and Technology',
		location: 'Coimbatore, India',
		highlights: [
			'CGPA: 8.79/10',
			'Hack from Home 2021: My team won for the “Best Health/COVID Track.”',
			'HackClub Member',
		],
		side: 'left',
		tone: 'violet',
		start: '0rem',
		length: '38rem',
	},
	{
		period: 'Jan 2023 — Jun 2023',
		type: 'Internship',
		title: 'Amazon',
		location: 'Bengaluru, India',
		role: 'SDE Intern in Alexa International Organization',
		description:
			'Developed a full-stack scheduling system for an internal Amazon QA automation platform, supporting approximately 50,000 test jobs and reducing manual setup time by 15–20 minutes per job using Java, AWS, React, and TypeScript.',
		brand: 'amazon',
		side: 'right',
		tone: 'amber',
		start: '34rem',
		length: '22rem',
	},
	{
		period: 'Aug 2025 — Jun 2027',
		type: 'Education',
		title: 'University of California, Santa Cruz',
		location: 'Santa Cruz, California',
		courses: [
			'Analysis of Algorithms',
			'Network Security',
			'Programming Languages',
			'Artificial Intelligence',
			'Probability and Statistics',
			'Machine Learning',
		],
		highlights: ["Group Tutor for CSE 143 — Spring '26"],
		side: 'left',
		tone: 'blue',
		start: '82rem',
		length: '24rem',
	},
];

const personalNotes = [
	'I like football, and I support Real Madrid.',
	'I used to follow F1 regularly, but I still watch a race from time to time.',
	'I like reading books, and I love writing stories—they can be pretty nonsensical, lol.',
	'I have been playing the guitar, and I am quite satisfied with my progress so far.',
	'I love tasting different cuisines, traveling, and just talking philosophy.',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/manish-hero.jpg" />
	</head>
	<body>
		<Header />
		<main>
			<div class="chapter-deck">
				<div class="chapter-viewport">
			<section class="hero chapter transition-zoom" id="top" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/manish-hero.jpg"
					alt="Manish standing in front of the Golden Gate Bridge"
					width="2560"
					height="1920"
					fetchpriority="high"
				/>
				<div class="hero-overlay" aria-hidden="true"></div>
				<div class="hero-content">
					<h1 id="hero-title" class="reveal">
						<span>Hello, I am Manish,</span>
						<span class="hero-secondary">and welcome to my page.</span>
					</h1>
					<div class="hero-footer reveal">
						<p>I’m learning how to turn hard questions into thoughtful, useful technology.</p>
						<a class="text-link" href="#research">Begin the story <span aria-hidden="true">↓</span></a>
					</div>
				</div>
			</section>

			<section class="about chapter transition-right" id="research" aria-labelledby="research-title">
				<div class="chapter-inner">
					<div class="section-heading reveal">
						<p class="chapter-number">Chapter 01 · My research interests</p>
						<h2 id="research-title">Understanding change<br />through data.</h2>
					</div>
					<div class="about-grid">
						<div class="about-copy reveal">
							<p class="lead">
								I am currently pursuing my Master's in CSE at UC Santa Cruz. My research
								interests sit at the intersection of machine learning, computational
								neuroscience, and clinical health data.
							</p>
							<p>
								I am interested in building models that help explain how neurological and
								behavioral changes unfold over time, especially in neurodegenerative disease.
							</p>
							<p>
								A secondary area of interest is the relationship between hearing impairment,
								communication barriers, and neuropsychiatric or cognitive outcomes. I am
								particularly interested in how sensory impairment may affect clinical
								interpretation, symptom measurement, and downstream disease modeling.
							</p>
							<p>
								More broadly, I want to work on computational methods that make clinical and
								neurobiological data more interpretable, especially in settings where symptoms,
								imaging, and cognition evolve together over time.
							</p>
						</div>
						<figure class="research-visual reveal">
							<img
								src="/research-brain.jpg"
								alt="A luminous blue and violet brain traced with neural connections"
								width="1254"
								height="1254"
								loading="lazy"
								decoding="async"
							/>
						</figure>
					</div>
				</div>
			</section>

			<section class="projects chapter transition-right" id="projects" aria-labelledby="projects-title">
				<div class="chapter-inner projects-intro reveal">
					<p class="chapter-number">Chapter 02 · Selected projects</p>
					<h2 id="projects-title">Built, tested,<br />and still unfolding.</h2>
				</div>
				<div class="project-stack">
					{projects.map((project) => (
						<article class:list={['project-panel', `project-${project.tone}`]}>
							<div
								class:list={[
									'project-art',
									'reveal',
									{
										'project-art-reddit': project.visual === 'reddit',
										'project-art-brainocare': project.visual === 'brainocare',
										'project-art-lit-rag': project.visual === 'lit-rag',
									},
								]}
							>
								<span class="project-index">{project.index}</span>
								{project.visual === 'reddit' ? (
									<img
										src="/reddit-project.jpg"
										alt="Reddit mascot Snoo waving on an orange background"
										width="1983"
										height="793"
										loading="lazy"
										decoding="async"
									/>
								) : project.visual === 'brainocare' ? (
									<img
										src="/brainocare-project.jpg"
										alt="BrainoCare in charcoal lettering on a warm orange background"
										width="1659"
										height="948"
										loading="lazy"
										decoding="async"
									/>
								) : project.visual === 'lit-rag' ? (
									<div class="rag-network" aria-hidden="true">
										<div class="rag-query">What does the literature say?</div>
										<div class="rag-path"></div>
										<div class="rag-source rag-source-one"><span>PMID</span> Semantic retrieval</div>
										<div class="rag-source rag-source-two"><span>PMID</span> Grounded claims</div>
										<div class="rag-source rag-source-three"><span>PMID</span> Citation validation</div>
									</div>
								) : (
									<div class="project-shape"></div>
								)}
							</div>
							<div class="project-copy reveal">
								<p class="project-status"><span></span>{project.status}</p>
								<h3>{project.title}</h3>
								{project.description && <p>{project.description}</p>}
								{(project.appUrl || project.url) && (
									<div class="project-actions">
										{project.appUrl && (
											<a class="project-link" href={project.appUrl}>
												Launch application <span aria-hidden="true">→</span>
											</a>
										)}
										{project.url && (
											<a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
												{project.appUrl ? 'GitHub' : 'View on GitHub'} <span aria-hidden="true">↗</span>
											</a>
										)}
									</div>
								)}
								{project.metric && (
									<div class="project-metric">
										<strong>{project.metric}</strong>
										<span>{project.metricLabel}</span>
									</div>
								)}
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="journey chapter chapter-dark transition-zoom" id="journey" aria-labelledby="journey-title">
				<div class="chapter-inner">
					<div class="section-heading reveal">
						<p class="chapter-number">Chapter 03 · My journey</p>
						<h2 id="journey-title">Still becoming.</h2>
					</div>
					<div class="timeline">
						<div class="timeline-rail" aria-hidden="true"></div>
						{journeyMilestones.map((milestone) => (
							<article
								class:list={['timeline-item', 'reveal', `timeline-${milestone.side}`, `timeline-${milestone.tone}`]}
								style={`--timeline-start: ${milestone.start}; --timeline-length: ${milestone.length};`}
							>
								<span class="timeline-node timeline-node-start" aria-hidden="true"></span>
								<span class="timeline-node timeline-node-end" aria-hidden="true"></span>
								<div class="timeline-card">
									{milestone.brand === 'amazon' && (
										<svg class="timeline-amazon-mark" viewBox="0 0 320 130" aria-hidden="true">
											<path d="M24 61c72 53 185 62 264 8" />
											<path d="M258 53c17-2 30 1 38 8-2 15-8 27-18 37" />
										</svg>
									)}
									<p class="timeline-period">{milestone.period}</p>
									<div class="timeline-details">
										<p class="timeline-type">{milestone.type}</p>
										<h3>{milestone.title}</h3>
										<p class="timeline-location">{milestone.location}</p>
										{milestone.role && <p class="timeline-role">{milestone.role}</p>}
										{milestone.description && <p class="timeline-description">{milestone.description}</p>}
										{milestone.courses && (
											<div class="timeline-courses">
												<p>Courses taken</p>
												<ul>
													{milestone.courses.map((course) => <li>{course}</li>)}
												</ul>
											</div>
										)}
										{milestone.highlights && (
											<ul class="timeline-highlights">
												{milestone.highlights.map((highlight) => <li>{highlight}</li>)}
											</ul>
										)}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="research chapter transition-left" id="personal" aria-labelledby="personal-title">
				<div class="chapter-inner">
					<div class="section-heading personal-heading reveal">
						<p class="chapter-number">Chapter 04 · Personal life</p>
						<h2 id="personal-title">Beyond the work.</h2>
					</div>
					<ul class="personal-list">
						{personalNotes.map((note, index) => (
							<li class="personal-item reveal">
								<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<p>{note}</p>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="connect chapter chapter-dark" id="connect" aria-labelledby="connect-title">
				<div class="chapter-inner">
					<div class="connect-heading reveal">
						<p class="chapter-number">Chapter 05 · Connect</p>
						<h2 id="connect-title">Let’s make the<br />next thing matter.</h2>
						<p>I’m always open to thoughtful conversations, ambitious ideas, and opportunities to learn.</p>
					</div>
					<div class="connect-grid reveal">
						<div class="connect-card">
							<span>Résumé</span>
							<strong>Available on request</strong>
						</div>
						<div class="connect-card">
							<span>Email</span>
							<a class="email-link" href="mailto:manish.pragaladan@outlook.com">
								manish.pragaladan@outlook.com
							</a>
							<small>Send me a message</small>
						</div>
						<div class="connect-card connect-socials">
							<span>Elsewhere</span>
							<div class="social-list">
								<a
									class="instagram"
									href="https://www.instagram.com/manishpragaladan"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Manish on Instagram"
									title="Instagram"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="5"></rect>
										<circle cx="12" cy="12" r="4.25"></circle>
										<circle class="icon-dot" cx="17.4" cy="6.7" r="1"></circle>
									</svg>
									<span class="sr-only">Instagram</span>
								</a>
								<a
									class="linkedin"
									href="https://www.linkedin.com/in/manish-pragaladan-9b0333209"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Manish on LinkedIn"
									title="LinkedIn"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M6.4 8.3V19"></path>
										<path d="M6.4 5.2v.1"></path>
										<path d="M10.7 19v-6.1c0-2.1 1.4-3.5 3.5-3.5s3.4 1.4 3.4 3.8V19"></path>
										<path d="M10.7 9.8V19"></path>
									</svg>
									<span class="sr-only">LinkedIn</span>
								</a>
								<a
									class="github"
									href="https://github.com/manish-prahaladan"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Manish on GitHub"
									title="GitHub"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M15.5 21v-3.5c.1-1-.3-1.8-.8-2.3 2.7-.3 5.5-1.3 5.5-6a4.7 4.7 0 0 0-1.3-3.3 4.4 4.4 0 0 0-.1-3.3s-1-.3-3.5 1.3a12.1 12.1 0 0 0-6.4 0C6.5 2.3 5.4 2.6 5.4 2.6a4.4 4.4 0 0 0-.1 3.3A4.7 4.7 0 0 0 4 9.2c0 4.7 2.8 5.7 5.5 6-.5.5-.8 1.1-.8 2.1V21"></path>
										<path d="M8.7 18.5c-2.7.8-2.7-1.5-3.8-1.8"></path>
									</svg>
									<span class="sr-only">GitHub</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			const revealItems = document.querySelectorAll('.reveal');
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (reducedMotion || !('IntersectionObserver' in window)) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.16 },
				);
				revealItems.forEach((item) => observer.observe(item));
			}

			const deck = document.querySelector<HTMLElement>('.chapter-deck');
			const viewport = deck?.querySelector<HTMLElement>('.chapter-viewport');
			const panels = viewport
				? Array.from(viewport.querySelectorAll<HTMLElement>('.chapter'))
				: [];

			if (!reducedMotion && deck && viewport && panels.length) {
				let frameRequested = false;
				let viewportHeight = window.innerHeight;
				let totalDistance = 0;
				let panelMetrics: Array<{
					start: number;
					holdDistance: number;
					contentTravel: number;
					transitionDistance: number;
				}> = [];
				const panelStarts = new Map<string, number>();
				const clamp = (value: number, min: number, max: number) =>
					Math.min(Math.max(value, min), max);

				const measureDeck = () => {
					viewportHeight = window.innerHeight;
					panelStarts.clear();
					totalDistance = 0;
					panelMetrics = panels.map((panel, index) => {
						const contentTravel = Math.max(0, panel.scrollHeight - viewportHeight);
						const holdDistance = index === panels.length - 1 ? 0 : viewportHeight * 0.55;
						const transitionDistance = index === panels.length - 1 ? 0 : viewportHeight * 1.35;
						const metric = {
							start: totalDistance,
							holdDistance,
							contentTravel,
							transitionDistance,
						};

						if (panel.id) panelStarts.set(panel.id, totalDistance);
						totalDistance += holdDistance + contentTravel + transitionDistance;
						return metric;
					});

					deck.style.height = `${totalDistance + viewportHeight}px`;
				};

				const resetPanel = (panel: HTMLElement) => {
					panel.style.opacity = '0';
					panel.style.pointerEvents = 'none';
					panel.style.zIndex = '0';
					panel.style.transform = 'translate3d(0, 0, 0)';
					panel.style.borderRadius = '0';
					panel.style.boxShadow = 'none';
					panel.style.setProperty('--text-reveal', '-12%');
				};

				const updateDeck = () => {
					const deckProgress = clamp(window.scrollY - deck.offsetTop, 0, totalDistance);
					let activeIndex = panels.length - 1;

					for (let index = 0; index < panelMetrics.length; index += 1) {
						const metric = panelMetrics[index];
						const end =
							metric.start +
							metric.holdDistance +
							metric.contentTravel +
							metric.transitionDistance;
						if (deckProgress <= end) {
							activeIndex = index;
							break;
						}
					}

					panels.forEach(resetPanel);

					const activePanel = panels[activeIndex];
					const nextPanel = panels[activeIndex + 1];
					const metric = panelMetrics[activeIndex];
					const localProgress = deckProgress - metric.start;
					const textRevealProgress = metric.holdDistance
						? clamp(localProgress / metric.holdDistance, 0, 1)
						: 1;
					const contentProgress = Math.max(0, localProgress - metric.holdDistance);
					const contentOffset = Math.min(contentProgress, metric.contentTravel);
					const transitionProgress = metric.transitionDistance
						? clamp(
								(contentProgress - metric.contentTravel) / metric.transitionDistance,
								0,
								1,
							)
						: 0;
					const easedProgress =
						transitionProgress * transitionProgress * (3 - 2 * transitionProgress);
					const incomingProgress = clamp((transitionProgress - 0.08) / 0.72, 0, 1);
					const easedIncoming =
						incomingProgress * incomingProgress * (3 - 2 * incomingProgress);
					const fadeProgress = clamp((transitionProgress - 0.45) / 0.55, 0, 1);
					const easedFade = fadeProgress * fadeProgress * (3 - 2 * fadeProgress);

					if (nextPanel) {
						nextPanel.style.opacity = easedIncoming.toString();
						nextPanel.style.zIndex = '1';
						nextPanel.style.transform = `scale(${1.025 - easedIncoming * 0.025})`;
					}

					let activeTransform = `translate3d(0, ${-contentOffset}px, 0)`;
					if (transitionProgress > 0) {
						if (activePanel.classList.contains('transition-zoom')) {
							activeTransform += ` scale(${1 - easedProgress * 0.2})`;
							activePanel.style.borderRadius = `${easedProgress * 2.5}rem`;
							activePanel.style.boxShadow = `0 2rem 7rem rgba(0, 0, 0, ${easedProgress * 0.38})`;
						} else if (activePanel.classList.contains('transition-left')) {
							activeTransform += ` translateX(${-110 * easedProgress}vw)`;
						} else {
							activeTransform += ` translateX(${110 * easedProgress}vw)`;
						}
					}

					activePanel.style.opacity = `${1 - easedFade}`;
					activePanel.style.pointerEvents = 'auto';
					activePanel.style.zIndex = '2';
					activePanel.style.transform = activeTransform;
					activePanel.style.setProperty(
						'--text-reveal',
						`${textRevealProgress * 112 - 12}%`,
					);
					frameRequested = false;
				};

				const requestDeckFrame = () => {
					if (!frameRequested) {
						window.requestAnimationFrame(updateDeck);
						frameRequested = true;
					}
				};

				const scrollToPanel = (id: string, behavior: ScrollBehavior = 'smooth') => {
					const panelStart = panelStarts.get(id);
					if (panelStart === undefined) return false;
					window.scrollTo({ top: deck.offsetTop + panelStart, behavior });
					return true;
				};

				deck.classList.add('is-active');
				revealItems.forEach((item) => item.classList.add('is-visible'));
				measureDeck();
				updateDeck();

				document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
					link.addEventListener('click', (event) => {
						const targetId = new URL(link.href, window.location.href).hash.slice(1);
						if (targetId && scrollToPanel(targetId)) {
							event.preventDefault();
							history.pushState(null, '', `#${targetId}`);
						}
					});
				});

				if (window.location.hash) {
					window.requestAnimationFrame(() => scrollToPanel(window.location.hash.slice(1), 'auto'));
				}

				window.addEventListener('scroll', requestDeckFrame, { passive: true });
				window.addEventListener('resize', () => {
					measureDeck();
					requestDeckFrame();
				});
			}
		</script>
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		background: #f5f5f7;
	}

	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
		overflow: clip;
	}

	.chapter-deck.is-active {
		position: relative;
		background: #070709;
	}

	.chapter-deck.is-active .chapter-viewport {
		position: sticky;
		top: 0;
		height: 100svh;
		overflow: hidden;
		background: #070709;
	}

	.chapter-deck.is-active .chapter {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		width: 100%;
		height: max-content;
		min-height: 100svh;
		margin: 0;
		transform-origin: center;
		will-change: transform, opacity;
	}

	.chapter {
		position: relative;
		padding: 9rem 0;
	}

	.chapter-inner,
	.hero-content {
		width: min(1240px, calc(100% - 3rem));
		margin: 0 auto;
	}

	.chapter-dark {
		background: #070709;
		color: #f5f5f7;
	}

	.chapter-number,
	.eyebrow {
		margin: 0;
